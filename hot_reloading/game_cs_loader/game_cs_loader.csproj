<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>

    <!-- Unmanaged function pointers and [UnmanagedCallersOnly] entry points,
         plus reflection-obtained function pointers for the reloadable game. -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>

    <!-- This is a library, but the Rust host loads it via hostfxr — it now
         hosts this loader instead of game_cs directly, so it needs its own
         runtimeconfig.json describing the target framework. -->
    <GenerateRuntimeConfigurationFiles>true</GenerateRuntimeConfigurationFiles>
  </PropertyGroup>

</Project>
